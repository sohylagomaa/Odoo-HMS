<odoo>
    <record id="view_hms_patient_form" model="ir.ui.view">
        <field name="name">hms.patient.form</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="undetermined,good,fair,serious"/>
                </header>
                <sheet>
                    <field name="image" widget="image"/>
                    <group>
                        <group string="Personal Info">
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                            <field name="address"/>
                        </group>
                        <group string="Medical Info">
                            <field name="department_id"/>
                            <field name="capacity" readonly="1"/>
                            <field name="doctor_ids"
                                   widget="many2many_tags"
                                   readonly="not department_id"/>
                            <field name="pcr"/>
                            <field name="cr_ratio"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medical History" invisible="age &lt; 50">
                            <field name="history"/>
                        </page>
                        <page string="Log History">
                            <field name="log_ids">
                                <list editable="bottom">
                                    <field name="created_by" readonly="1"/>
                                    <field name="date" readonly="1"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hms_patient_list" model="ir.ui.view">
        <field name="name">hms.patient.list</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="age"/>
                <field name="blood_type"/>
                <field name="pcr"/>
                <field name="department_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_hms_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hms_patients" name="Patients"
              parent="menu_hms_root"
              action="action_hms_patient"/>
</odoo>